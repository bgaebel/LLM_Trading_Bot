<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_F_Add_Test" Id="{b4ef63f9-c392-4829-8d52-c12c48bd7ff5}" SpecialFunc="None">
    <Declaration><![CDATA[// TcUnit test suite for F_Add. Each test is one method; the body calls them all.
FUNCTION_BLOCK FB_F_Add_Test EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[AddsTwoPositiveNumbers();
AddsNegativeNumber();]]></ST>
    </Implementation>
    <Method Name="AddsTwoPositiveNumbers" Id="{fad2b562-7465-4715-a271-d3d878911649}">
      <Declaration><![CDATA[METHOD PRIVATE AddsTwoPositiveNumbers
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AddsTwoPositiveNumbers');

AssertEquals_INT(Expected := 5,
                 Actual := F_Add(nA := 2, nB := 3),
                 Message := '2 + 3 must be 5');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddsNegativeNumber" Id="{739ffa0c-f94d-43dc-9f85-dea5d3bdd95d}">
      <Declaration><![CDATA[METHOD PRIVATE AddsNegativeNumber
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AddsNegativeNumber');

AssertEquals_INT(Expected := -1,
                 Actual := F_Add(nA := 2, nB := -3),
                 Message := '2 + (-3) must be -1');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
